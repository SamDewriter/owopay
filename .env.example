# Copy to .env (make does this for you on first run). .env never leaves your laptop.
# Compose, the Makefile, the generator, dbt and the notebooks all read these names.

# Postgres: one container, databases owopay (OLTP), dw (warehouse), airflow, metabase
PG_HOST=localhost
PG_PORT=5432
PG_USER=owopay
PG_PASSWORD=owopay
PG_DB=owopay
DW_DB=dw

# Redpanda (Kafka API) and its Schema Registry
KAFKA_BOOTSTRAP=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# SeaweedFS S3 gateway. The same keys are in seaweedfs/s3.json; change both or neither.
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=owopay
S3_SECRET_KEY=owopay-dev-secret
S3_REGION=us-east-1

# Airflow
AIRFLOW_URL=http://localhost:8080
AIRFLOW_SERVICE=airflow-scheduler
AIRFLOW_UID=50000

# Generator: everyone uses the same seed so everyone's numbers match
OWOPAY_SEED=20261030
